# Borsel Handler Configuration Template
APP_NAME="Borsel Handler Intelligence Platform"
APP_VERSION="2.0.0"
DEBUG=false
ENVIRONMENT=production

# Database Configuration
# Production (PostgreSQL 14+):
# DATABASE_URL=postgresql://borsel_user:secure_password@localhost:5432/borsel_db
# Local Development / Offline Testing (SQLite):
DATABASE_URL=sqlite:///./borsel_handler.db

# Ingestion & Scheduler Settings
DEFAULT_LOOKBACK_HOURS=48
HTTP_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2.0
COLLECTION_INTERVAL_MINUTES=60
COLLECTION_RATE_LIMIT_RPS=2.0

# Security & Operational Access Controls (Optional shared secret / API key)
API_SECRET_KEY=
SITE_PASSWORD=

# Optional 3rd party API keys
MARKETAUX_API_KEY=
ANTHROPIC_API_KEY=
